							{#+ min 0.15 0.05}
							{#+ max 0.5 0.1}
						}
					}
					{#+ timer
						{#+ mode play }
						{#+ duration -1}
					}
					{#+ preturn 0 20}
					{#+ highlight 0xffaaa994}
				}
				{##+ sprite "$/smoke/smokesmal4b_ground"
