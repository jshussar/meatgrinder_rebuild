{fx
	{#+ sound "hit/wood/bullet/"}
	{particleview dust
		{generator
			{#+ totalparticles 15}
			{#+ particlesinblock 15}
			{#+ emissionarea
				{#+ radius 5 5}
				{#+ alpha0 0}
				{#+ alpha1 60 30}
			}
			{particleinit
				{#+ speed 1.5 1.5}
				{#+ lifetime 1.75 0.75}
			}
			{#+ timetolive 1}
			{#+ axisz}
		}
		{mover
			{#+ damping 0.94}
			{gravity
				{#+ value 0.01}
			}
			{#+ collisions
				{#+ terrain}
				{#+ restitution 0.05}
			}
		}
		{visualizer
			{stage 
				{## sprite "$/smoke/smoke_g04f"
					{#+ turn 1
						{#+ linear
							{#+ min 0}
							{#+ max 0 30}
						}
					}
