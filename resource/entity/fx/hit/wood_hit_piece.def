{fx
	{#+ sound "crush/small/sandbag"}
	{particleview dust
		{generator
			{#+ totalparticles 10}
			{#+ particlesinblock 10}
			{emissionarea
				{#+ radius 5 5}
				{#+ alpha0 0}
				{#+ alpha1 60 30}
			}
			{particleinit
				{#+ speed 0.5 0.5}
				{#+ lifetime 3.5 1}
			}
			{#+ timetolive 1}
			{#+ axisz}
		}
		{mover
			{#+ damping 0.94}
