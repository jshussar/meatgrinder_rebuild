							{#+ min 0.3 0.1}
							{#+ max 0}
						}
					}
					{scale 1
						{linear
							{#+ min 1}
							{#+ max 1.6 0.4}
						}
					}
					{#+ timer
						{#+ mode play }
						{#+ duration -1}
					}
					{#+ preturn 90 90}
					{#+ highlight 0xffb4aea3}
				}
				{##+ sprite "$/smoke/smoke_g04b"
