{human
	{extension "human.mdl"}
	(include "/properties/human.ext")
	(include "/properties/selection/human.inc")
	{ObstacleId "human_impassable" "impassable"}
	{NoVisibilityPatch}
	{NoGroupMesh 1}
	{RimLight}

	{Obstacle 
		{Circle2 {radius 5}}
	}
	{Obstacle "impassable"
		{Circle2 {radius 6}}
	}
	{Skeleton
		{ViewVolume 
			{center 0 0 18}
			{extent 30 30 18}
		}
	}

	{volume "spacer"
		{able {contact 0}{contact_ground 0}{bullet 0} {obstacle 0}{overlap 1}{touch 0}}
		{density 0.007}
	}
	{Volume "Foot1R" {tags "no_target"}}
	{Volume "Foot2R" {tags "no_target"}}
	{Volume "Foot1L" {tags "no_target"}}
	{Volume "Foot2L" {tags "no_target"}}
	{Volume "ram" {tags "no_target"}}
}
