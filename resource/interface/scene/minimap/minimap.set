{minimap
	(define "scale"
		{scale (* 1.1 %s)}
	)
	{settings
		{max_tracers		100	}
		{tracer_length		0.9	} ; 0.9
		{rotation_speed		1	}
		{padding			25	}; 10
		{margin				25	}; 10
	}
	{colors
		{neutral			0xffffffff}
		{self				0xff5691FF}
		{ally				0xff54C600}
		{coop_ally			0xff00D3B7}
		{enemy				0xffD9412B}
		{selected			0xffffffff}
		{friendly_tracer	0xff00FF00}
		{enemy_tracer		0xffE1008F}
	}
	{frequencies ; flashing speed of certain minimap entities
		{flag_capturing 2}
		{flag_losing 2}
		{selected_units 1}
	}
