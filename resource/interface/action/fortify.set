{action "barricade"
	{cursor "barricade"}
	{fx "flashred"}
	{item "sandbag_kit"}
	{item_in_box}
	{entity "sandbag3"}
	{Button}
	{Cost 1}
	{TerrainRestrictions "water"}
	{Spacing 1.8}
	{AbleRotate}
	{AbleEnqueue}
	{AbleDrag}
	{ShowCount}
	{Key "actions/barricade"}
	{instructions
		{bind range 1}
		{disable_action_restart}
		;
		{take_item}
		{free_hands}
		{reserve_hands}
		{animations "squat_repair_1 squat_repair_2" random loop totaltime 20 paint 1}
		{install "sandbag3" 0.0}
		{unreserve_hands}
		{remove_from_inventory}
		{fsm_request nocheck "hold-nothing"}
	}
}


