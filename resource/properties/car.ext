;SDL
actor

(include "vehicle.ext")
(include "car_crew.ext")
(include "armor.ext")
(include "abm.inc")
(include "mobility.inc")

("brain_vehicle")

{hearingBias 4.5} ; in meters
{collider "car"}
{props "car" "engine" "wheeled" "turn_over" "tow_vehicle"}
{targetClass "car"}
{targetSelector "car_bullet"}

{able "talk"}

{extender "talk"
	{talker "cannon"}
}

{placer
	{place "driver"
		{visor "main"}
		{UseVision 0}
	}
}

{sensor
	{visor "main"
		{vision "vehicle_main"}
		{bone "visor2"}
	}
	{visor "around"
		{vision "human_peripheral"}
		{bone "visor1"}
	}
	{visor "none"
		{vision "none"}
	}
}

{extender "inventory"
	{box
		{Size 9 10}
		{weight 2000}
		{item "can" 1}
		{item "repair_kit" 20}
	}
}

(define "restore_ik_time"
	{RestoreIKTime 10}
)

{Chassis "wheel"
	("chassis_defaults")
}

