		{8.6	2}
		{8.8	35}
		{9.0	4}
		{9.2	60}
		{9.4	1}
		{9.6	40}
		{9.8	2.5}
		
		; 10-20°: BROADER SWINGS, EXTREME RANGE
		{10.0	5}
		{10.5	40}		; Maximum possible for this angle
		{11.0	3}
		{11.5	25}
		{12.0	6}
		{12.5	30}		; massive bounce
		{13.0	4}
		{13.5	30}
		{14.0	7}
		{14.5	20}
		{15.0	5}
		{15.5	35}		; Wild bounce
