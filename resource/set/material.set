(define "cunted"
	{angle
		; 0°: BASE REFERENCE
		{0	0}
		
		; 0-5°: EXTREME MICRO-CHATOIC TERRAIN
		; Simulating individual rocks, pebbles, debris
		
		{0		0}		; consistent start
		{0.1	4}		; Small skip on a stone
		{0.2	12}		; Hit large rock immediately
		{0.3	1.5}	; Smooth patch
		{0.4	8}		; Medium stone
		{0.5	2}	; Almost nothing
		{0.6	15}		; Boulder
		{0.7	2.5}	; Smooth
		{0.8	5}		; Small rock cluster
		{0.9	20}		; Large debris
		
		{1.0	1.5}		; Base
		{1.1	18}		; Random large rock
		{1.2	2}	; Smooth
		{1.3	10}		; Medium obstacle
		{1.4	3}		; Minor feature
		{1.5	25}		; Shell casing or debris
		{1.6	4}	; Clear
		{1.7	7}		; Small stone
		{1.8	30}		; Extreme: hit something metallic
		{1.9	3}	; Back to ground
		
