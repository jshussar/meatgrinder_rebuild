;SDL

;===================================
;        INSTRUCTIONS    
;===================================

; In this file onee configures the humans which are spawned in vehicles or squads
; The humans have a CP and cost associated with them which collectively add up for the final squad value
; Check ../settings_inf.set for the global defines for CP, capture weight (CW), score, etc.

;===================================
;        PRICING CHART	       
;===================================

; // Standard prices below are for tier2 infantry

;k98 			= 8
;mp40/mp38 		= 10
;g41 			= 13
;g43 			= 13
;mkb42(h)		= 20
;stg44			= 20
;fg42 			= 22
;MG26(t)		= 25
;MG13			= 25
;mg34 drum 		= 35
;mg34 belt 		= 40
;mg42 drum 		= 35
;mg42 belt 		= 40
;rifle grenade	= +5
;marksman 		= +2
;any % pzfaust 	= +0
;any pzfaust 	= +0
;any flamer		= 50
;engineer		= 50
;miner 			= 40

; // price modifiers (If not tier2)
;tier 0 		= -3, MG -10
;tier 1 		= -1, MG -10
;tier 1 vet 	= 0, MG 0
;tier 2 vet		= +2, MG +5
;tier 3 		= +5, MG +10
;tier 3 vet 	= +8, MG +15
;tier 4 		= +10, MG +20
;tier 4 vet 	= +12, MG +25


;===================================
;        BREED DECLARATIONS       
;===================================



